FRONTEND_PORT=5173
BACKEND_PORT=8000

DATABASE_URL=replace_with_shared_supabase_database_url

# Local lesson retrieval works without an API key.
RAG_ENABLED=true
RAG_TOP_K=3
# Optional retrieval-augmented OpenAI generation (backend only).
RAG_GENERATION_ENABLED=false
OPENAI_API_KEY=
RAG_MODEL=gpt-4.1-mini
RAG_TIMEOUT_SEC=15
