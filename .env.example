FRONTEND_PORT=5173
BACKEND_PORT=8000

DATABASE_URL=replace_with_shared_supabase_database_url

# Private backend-only keys for researcher CSV ZIP downloads (16+ characters each).
GAME_COLLECTION_EXPORT_KEY=
QUIZ_COLLECTION_EXPORT_KEY=

# Experimental Dynamic Quiz inference is off unless explicitly enabled on the isolated SQLite demo.
QUIZ_DYNAMIC_ML_DEMO_ENABLED=false

# Local lesson retrieval works without an API key.
RAG_ENABLED=true
RAG_TOP_K=3
# Optional retrieval-augmented OpenAI generation (backend only).
RAG_GENERATION_ENABLED=false
OPENAI_API_KEY=
RAG_MODEL=gpt-4.1-mini
RAG_TIMEOUT_SEC=15
