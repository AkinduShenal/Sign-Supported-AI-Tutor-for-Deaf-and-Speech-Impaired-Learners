{
  "rules": [
    {
      "pattern": "\\bsubstitut(?:e|ed|ion)\\b",
      "actions": [
        "SUBSTITUTION"
      ]
    },
    {
      "pattern": "\\b(?:subtract|subtracted|subtraction|minus|take away)\\b",
      "actions": [
        "SUBTRACTION"
      ]
    },
    {
      "pattern": "\\b(?:add|added|addition|plus)\\b",
      "actions": [
        "ADDITION"
      ]
    },
    {
      "pattern": "\\b(?:multiply|multiplied|multiplication|times)\\b",
      "actions": [
        "MULTIPLICATION"
      ]
    },
    {
      "pattern": "\\b(?:divide|divided|division)\\b",
      "actions": [
        "DIVISION"
      ]
    },
    {
      "pattern": "\\b(?:equation|equal|equals)\\b",
      "actions": [
        "EQUATION"
      ]
    },
    {
      "pattern": "\\b(?:balance|balanced|keep equal)\\b",
      "actions": [
        "BALANCE"
      ]
    },
    {
      "pattern": "\\b(?:both sides|same operation)\\b",
      "actions": [
        "BOTH_SIDES"
      ]
    },
    {
      "pattern": "\\b(?:variable|unknown)\\b",
      "actions": [
        "VARIABLE"
      ]
    },
    {
      "pattern": "\\b(?:algebra|algebraic)\\b",
      "actions": [
        "ALGEBRA"
      ]
    },
    {
      "pattern": "\\bexpression\\b",
      "actions": [
        "EXPRESSION"
      ]
    },
    {
      "pattern": "\\bcoefficient\\b",
      "actions": [
        "COEFFICIENT"
      ]
    },
    {
      "pattern": "\\bterm\\b",
      "actions": [
        "TERM"
      ]
    },
    {
      "pattern": "\\bsolve\\b",
      "actions": [
        "SOLVE"
      ]
    },
    {
      "pattern": "\\b(?:answer|result)\\b",
      "actions": [
        "ANSWER"
      ]
    },
    {
      "pattern": "\\bhint\\b",
      "actions": [
        "HINT"
      ]
    },
    {
      "pattern": "\\btry again\\b",
      "actions": [
        "TRY_AGAIN"
      ]
    },
    {
      "pattern": "\\bcorrect\\b",
      "actions": [
        "CORRECT"
      ]
    },
    {
      "pattern": "\\b(?:incorrect|wrong)\\b",
      "actions": [
        "INCORRECT"
      ]
    },
    {
      "pattern": "\\bpositive\\b",
      "actions": [
        "POSITIVE"
      ]
    },
    {
      "pattern": "\\bnegative\\b",
      "actions": [
        "NEGATIVE"
      ]
    },
    {
      "pattern": "\\b(?:bracket|parentheses)\\b",
      "actions": [
        "BRACKET"
      ]
    },
    {
      "pattern": "\\b(?:start|begin)\\b",
      "actions": [
        "START"
      ]
    },
    {
      "pattern": "\\b(?:next|continue)\\b",
      "actions": [
        "NEXT"
      ]
    },
    {
      "pattern": "\\b(?:previous|back)\\b",
      "actions": [
        "PREVIOUS"
      ]
    },
    {
      "pattern": "\\bstep by step\\b",
      "actions": [
        "STEP_BY_STEP"
      ]
    },
    {
      "pattern": "(?<!step by )\\bstep\\b(?!\\s+by\\s+step)",
      "actions": [
        "STEP"
      ]
    },
    {
      "pattern": "\\bexample\\b",
      "actions": [
        "EXAMPLE"
      ]
    },
    {
      "pattern": "\\bpractice\\b",
      "actions": [
        "PRACTICE"
      ]
    },
    {
      "pattern": "\\bquestion\\b",
      "actions": [
        "QUESTION"
      ]
    },
    {
      "pattern": "\\brepeat\\b",
      "actions": [
        "REPEAT"
      ]
    },
    {
      "pattern": "\\bcheck\\b",
      "actions": [
        "CHECK"
      ]
    },
    {
      "pattern": "\\b(?:finish|complete)\\b",
      "actions": [
        "FINISH"
      ]
    },
    {
      "pattern": "\\b(?:error correction|correct mistake)\\b",
      "actions": [
        "ERROR_CORRECTION"
      ]
    },
    {
      "pattern": "\\b(?:foundation|prerequisite)\\b",
      "actions": [
        "FOUNDATION"
      ]
    },
    {
      "pattern": "\\b(?:match|matching)\\b",
      "actions": [
        "MATCH"
      ]
    },
    {
      "pattern": "\\bdrag and drop\\b",
      "actions": [
        "DRAG_DROP"
      ]
    },
    {
      "pattern": "\\b(?:sign keyword|keyword)\\b",
      "actions": [
        "SIGN_KEYWORD"
      ]
    },
    {
      "pattern": "\\bvisual\\b",
      "actions": [
        "VISUAL"
      ]
    },
    {
      "pattern": "\\btext\\b",
      "actions": [
        "TEXT"
      ]
    },
    {
      "pattern": "\\beasy\\b",
      "actions": [
        "EASY"
      ]
    },
    {
      "pattern": "\\b(?:difficult|hard)\\b",
      "actions": [
        "DIFFICULT"
      ]
    },
    {
      "pattern": "\\b(?:slow|slower)\\b",
      "actions": [
        "SLOW"
      ]
    },
    {
      "pattern": "\\bnot improved\\b",
      "actions": [
        "NOT_IMPROVED"
      ]
    },
    {
      "pattern": "(?<!not )\\bimproved\\b",
      "actions": [
        "IMPROVED"
      ]
    }
  ],
  "expression_tokens": {
    "+": "ADDITION",
    "-": "SUBTRACTION",
    "−": "SUBTRACTION",
    "*": "MULTIPLICATION",
    "×": "MULTIPLICATION",
    "/": "DIVISION",
    "÷": "DIVISION",
    "=": "EQUATION",
    "x": "VARIABLE"
  },
  "sequence_policy": {
    "max_actions_per_step": 4,
    "prefer_instruction_over_raw_expression": true,
    "deduplicate": true,
    "allow_prototype_educational_gestures": true,
    "skip_missing_or_unvalidated_clips": true,
    "fallback_to_text_only": true
  }
}
